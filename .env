# .env
MASTER_BOT_TOKEN=YOUR_MASTER_BOT_TOKEN_HERE

# Database
DB_PATH=./reactions.db

# Reaction Settings
MIN_REACTIONS_PER_POST=5
MAX_REACTIONS_PER_POST=11
MIN_DELAY_MINUTES=1
MAX_DELAY_MINUTES=30

# Rate Limiting
DAILY_LIMIT_PER_BOT=250
BATCH_SIZE=10
BATCH_PAUSE_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./bot.log
